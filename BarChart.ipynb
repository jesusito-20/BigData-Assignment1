import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# adjust file names to match yours
q1 = pd.read_csv('benchmark_results_q1.csv')       # Run 1: ranks 16/64/256
q3 = pd.read_csv('benchmark_results_q3.csv')            # Q3 run: pos25 / pos50 / bottom

# Top = rank 16, component 'default' from Run 1
top = q1[(q1['rank'] == 16) & (q1['component'] == 'default')].iloc[0]

def row(comp):
    return q3[(q3['rank'] == 16) & (q3['component'] == comp)].iloc[0]

rows = {'Top': top, '25%': row('pos25'), '50%': row('pos50'), 'Bottom': row('bottom')}
colors = {'Top': '#93c47d', '25%': '#0b4560', '50%': '#f6b26b', 'Bottom': '#3c78d8'}

datasets = ['GSM8K', 'MATH']
x = np.arange(len(datasets))
w = 0.18

fig, ax = plt.subplots(figsize=(6, 4))
for i, (label, r) in enumerate(rows.items()):
    vals = [r['gsm8k_accuracy'], r['math_accuracy']]
    bars = ax.bar(x + (i - 1.5) * w, vals, w, label=label, color=colors[label])
    ax.bar_label(bars, fmt='%.3f', fontsize=7, padding=2)

ax.set_xticks(x)
ax.set_xticklabels(datasets)
ax.set_ylim(0, 1.0)
ax.set_yticks(np.arange(0, 1.01, 0.25))
ax.yaxis.grid(True, alpha=0.3)
ax.set_axisbelow(True)
ax.set_title('Accuracy', loc='left')
ax.legend(ncol=4, loc='upper center', frameon=False)
plt.tight_layout()
plt.savefig('q3_accuracy.png', dpi=200)
plt.show()
